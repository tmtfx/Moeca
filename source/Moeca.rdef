resource app_signature "application/x-vnd.piratidelfrico.Moeca";

resource app_version {
	major  = 2,
	middle = 0,
	minor  = 0,

	variety = B_APPV_BETA,
	internal = 1,

	short_info = "Moeca - AI Desktop Mascot",
	long_info =
		"Moeca is a desktop mascot for Haiku with AI chat powered by the system AI Server.\n"
};

resource file_types message {
	"types" = "image"
};

